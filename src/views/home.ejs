
<%- include('partials/header') %>

<main class="home-page">

    <section class="home-hero">

        <div class="home-content">
            <h1><%= title %></h1>

            <h2>Welcome to the CSE 340 Service Network!</h2>

            <p class="home-description">
                Our mission is to promote service across the world
                by connecting volunteers with service opportunities
                in their community.
            </p>

            <div class="home-actions">
                <a href="/projects" class="btn btn-primary">
                    Explore Projects
                </a>

                <% if (isLoggedIn) { %>
                    <a href="/dashboard" class="btn btn-secondary">
                        My Dashboard
                    </a>
                <% } else { %>
                    <a href="/register" class="btn btn-secondary">
                        Join Our Community
                    </a>
                <% } %>
            </div>
        </div>

        <div class="home-image">
            <img
                class="main-logo"
                src="/images/cse340-service-network.png"
                alt="CSE 340 Service Network Logo"
            >
        </div>

    </section>

    <section class="home-info">

        <h2>Make a Difference</h2>

        <p>
            Discover meaningful service opportunities, connect
            with organizations, and contribute to projects
            that make a positive impact in your community.
        </p>

        <div class="home-features">

            <article class="feature-card">
                <h3>Find Projects</h3>
                <p>
                    Browse service opportunities and find
                    projects that match your interests.
                </p>
                <a href="/projects">View Projects &rarr;</a>
            </article>

            <article class="feature-card">
                <h3>Explore Organizations</h3>
                <p>
                    Learn about organizations working
                    to improve communities.
                </p>
                <a href="/organizations">View Organizations &rarr;</a>
            </article>

            <article class="feature-card">
                <h3>Get Involved</h3>
                <p>
                    Sign up to volunteer and manage your
                    commitments from your dashboard.
                </p>

                <% if (isLoggedIn) { %>
                    <a href="/dashboard">My Dashboard &rarr;</a>
                <% } else { %>
                    <a href="/register">Get Started &rarr;</a>
                <% } %>
            </article>

        </div>

    </section>

</main>

<%- include('partials/footer') %>
