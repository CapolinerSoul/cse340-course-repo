<%- include('partials/header') %>

<main>
    <section class="users-section">
        <h1><%= title %></h1>

        <p class="page-description">
            View all registered Service Network users and their assigned roles.
        </p>

        <% if (users.length === 0) { %>
            <p>No registered users found.</p>
        <% } else { %>

            <div class="table-container">
                <table class="users-table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Role</th>
                        </tr>
                    </thead>

                    <tbody>
                        <% users.forEach(user => { %>
                            <tr>
                                <td><%= user.name %></td>
                                <td><%= user.email %></td>
                                <td>
                                    <span class="role-badge">
                                        <%= user.role_name %>
                                    </span>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>

        <% } %>

        <div class="users-actions">
            <a href="/dashboard" class="btn btn-secondary">
                Back to Dashboard
            </a>
        </div>
    </section>
</main>

<%- include('partials/footer') %>