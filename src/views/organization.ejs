<%- include('partials/header') %>

<main>
    <h2><%= organizationDetails.name %></h2>

    <img
        src="/images/<%= organizationDetails.logo_filename %>"
        alt="<%= organizationDetails.name %> logo"
    >

    <p><%= organizationDetails.description %></p>

    <h3>Service Projects</h3>

    <ul class="project-list">
        <% projects.forEach(project => { %>
            <li>
                <a href="/project/<%= project.project_id %>">
                    <%= project.title %>
                </a>
            </li>
        <% }) %>
    </ul>
        <div class="organization-actions">
    <a href="/edit-organization/<%= organizationDetails.organization_id %>" class="btn btn-primary">
        Edit Organization
    </a>
</div>
</main>

<%- include('partials/footer') %>