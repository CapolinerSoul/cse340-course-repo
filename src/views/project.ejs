<%- include('partials/header') %>

<main>
    <h1><%= projectDetails.title %></h1>

    <p><%= projectDetails.description %></p>

    <p>
        <strong>Date:</strong>
        <%= new Date(projectDetails.date).toLocaleDateString("en-US", {
            year: "numeric",
            month: "long",
            day: "numeric"
        }) %>
    </p>

    <p>
        <strong>Location:</strong>
        <%= projectDetails.location %>
    </p>

    <p>
        <strong>Partner Organization:</strong>
        <a href="/organization/<%= projectDetails.organization_id %>">
            <%= projectDetails.organization_name %>
        </a>
    </p>

    <p>
        <strong>Categories:</strong>

        <% categories.forEach(category => { %>
            <a
                class="category-tag"
                href="/category/<%= category.category_id %>"
            >
                <%= category.name %>
            </a>
        <% }); %>
    </p>
</main>
<div class="project-actions">
    <a href="/assign-categories/<%= projectDetails.project_id %>" class="btn btn-secondary">
        Change Project Categories
    </a>

    <a href="/edit-project/<%= projectDetails.project_id %>" class="btn btn-primary">
        Edit Project
    </a>
</div>
<%- include('partials/footer') %>